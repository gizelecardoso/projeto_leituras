<main class="mx-auto max-w-2xl px-6 py-10">

  <div class="rounded-xl bg-white p-8 shadow-sm">

    <h1 class="mb-2 text-3xl font-semibold text-[#285943]">
      Editar Livro
    </h1>

    <p class="mb-8 text-gray-500">
      Atualize as informações do livro.
    </p>

    <%= render "form", book: @book %>

    <%= link_to "Cancelar",
        book_path(@book),
        class: "mt-4 inline-block text-sm text-gray-600 hover:text-[#285943]" %>

  </div>
</main>
